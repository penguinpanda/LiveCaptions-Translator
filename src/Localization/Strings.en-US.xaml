    <sys:String x:Key="SettingPage_NetworkTimeout">Network Timeout (s)</sys:String>

    <!-- Flyout: LiveCaptions -->
    <sys:String x:Key="SettingPage_FlyoutLiveCaptions_1">After Windows 11 version 24H2, you can only change the </sys:String>
    <sys:String x:Key="SettingPage_FlyoutLiveCaptions_2">Source Language</sys:String>
    <sys:String x:Key="SettingPage_FlyoutLiveCaptions_3"> in LiveCaptions.&#x0A;&#x0A;Note: Please click "Hide" to hide LiveCaptions instead of closing it directly.</sys:String>

    <!-- Flyout: API Interval -->
    <sys:String x:Key="SettingPage_FlyoutInterval_1">Determines the frequency of translate API calls. The smaller it is, the more frequent API calls.&#x0A;The translate API is called once after the caption changes [API Interval] times.</sys:String>

    <!-- Flyout: Translate API -->
    <sys:String x:Key="SettingPage_FlyoutTranslateApi_1">Except for Google and Google2, all other APIs require configuring before they can be used.</sys:String>

    <!-- Flyout: Target Language -->
    <sys:String x:Key="SettingPage_FlyoutTargetLang_1">"There isn't the target language I expect!"&#x0A;You can directly edit the content of this combobox to customize the language, and it is recommended to follow the BCP 47 language tag.&#x0A;&#x0A;Note: Some of APIs (such as DeepL) needs another way to define target language, see their official docs for more details. No need to consider this for included target languages, since we've built in tag mappings. But if your expected language isn't in the list, keep this in mind.</sys:String>

    <!-- Flyout: Contexts / Display Sentences -->
    <sys:String x:Key="SettingPage_FlyoutContexts_1">Contexts: Determines the number of context sentences when Context Aware is enabled.&#x0A;Overlay Sentences: Determines the number of displayed cards when Log Cards is enabled, as well as the max number of sentences displayed in the Overlay Window.&#x0A;&#x0A;Note: Contexts must be greater than or equal Display Sentences. If not met, the program will automatically adjust them.</sys:String>

    <!-- Flyout: Context Aware -->
    <sys:String x:Key="SettingPage_FlyoutContextAware_1">Translate in context.&#x0A;It can improve translation accuracy, but will consume more tokens.</sys:String>

