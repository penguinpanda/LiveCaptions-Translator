    <sys:String x:Key="ApiSetting_Baidu">Baidu</sys:String>
    <sys:String x:Key="ApiSetting_LibreTranslate">LibreTranslate</sys:String>

    <!-- Flyout: Prompt notes -->
    <sys:String x:Key="ApiSetting_PromptNote1">Note 1: The {0} in the prompt indicates the target language, so make sure your prompt includes {0}.&#x0A;</sys:String>
    <sys:String x:Key="ApiSetting_PromptNote2">Note 2: The source text is enclosed with 🔤.</sys:String>

    <!-- Flyout: Ollama API Url -->
    <sys:String x:Key="ApiSetting_FlyoutOllamaUrl">No need to explicitly add `api/chat` suffix.</sys:String>
    <!-- Flyout: LMStudio API Url -->
    <sys:String x:Key="ApiSetting_FlyoutLMStudioUrl">Base URL ending with `api/v1`. Chat endpoint and models are appended automatically.</sys:String>
    <!-- Flyout: OpenAI API Url -->
    <sys:String x:Key="ApiSetting_FlyoutOpenAIUrl">Use Full Url (typically ending with `v1/chat/completions`) instead of Base Url (typically ending with just `v1`).</sys:String>

    <!--============================================================
        Info page
    ============================================================-->
    <sys:String x:Key="Info_Intro1">We welcome any form of contribution! You can provide suggestions or report bugs via GitHub issues, or contribute code directly by submitting Pull Requests.&#x0A;If this program is helpful to you, please consider giving us a star ✨!</sys:String>
    <sys:String x:Key="Info_Repository">Repository: </sys:String>
    <sys:String x:Key="Info_Wiki">Wiki: </sys:String>
    <sys:String x:Key="Info_Maintainer">Maintainer: </sys:String>
    <sys:String x:Key="Info_AuthorAnd">(Author) and </sys:String>
    <sys:String x:Key="Info_Version">Version: </sys:String>

    <!--============================================================
        Welcome window
    ============================================================-->
    <sys:String x:Key="Welcome_Title">Getting Started</sys:String>
    <sys:String x:Key="Welcome_Head">Welcome to LiveCaptions Translator!</sys:String>
    <sys:String x:Key="Welcome_Body_1">LiveCaptions Translator is based on Windows LiveCaptions. Before your first running, you need to configure it according to the following steps:&#x0A;</sys:String>
    <sys:String x:Key="Welcome_Body_2">&#x0A;1. Open Windows LiveCaptions and follow the guide to download the necessary files for on-device speech recognition and language packs.</sys:String>
    <sys:String x:Key="Welcome_Body_3">&#x0A;2. Click the </sys:String>
    <sys:String x:Key="Welcome_Body_4">⚙️ gear</sys:String>
    <sys:String x:Key="Welcome_Body_5"> icon in Windows LiveCaptions to open the settings menu, and select </sys:String>
    <sys:String x:Key="Welcome_Body_6">"Position &gt; Overlaid on screen"</sys:String>
    <sys:String x:Key="Welcome_Body_7">.&#x0A;3. Click the </sys:String>
    <sys:String x:Key="Welcome_Body_8">"Hide"</sys:String>
    <sys:String x:Key="Welcome_Body_9"> button located in the setting page of LiveCaptions Translator to hide Windows LiveCaptions.&#x0A;&#x0A;The program has automatically navigated to the setting page and opened Windows LiveCaptions. After completing the configuration, you can switch back to the main page and enjoy real-time audio translation.&#x0A;&#x0A;For more details, visit our wiki: </sys:String>
    <sys:String x:Key="Welcome_Body_10">&#x0A;&#x0A;Tip: To change the </sys:String>
    <sys:String x:Key="Welcome_Body_11">Source Language</sys:String>
    <sys:String x:Key="Welcome_Body_12">, please [Show] LiveCaptions on the setting page and do it in Windows LiveCaptions.</sys:String>
    <sys:String x:Key="Welcome_ConfirmButton">I have fully understood and configured.</sys:String>

