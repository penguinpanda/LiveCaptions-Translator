    <!--============================================================
        设置页
    ============================================================-->
    <sys:String x:Key="SettingPage_LiveCaptions">实时字幕</sys:String>
    <sys:String x:Key="SettingPage_ApiInterval">API 调用间隔</sys:String>
    <sys:String x:Key="SettingPage_TranslateApi">翻译 API</sys:String>
    <sys:String x:Key="SettingPage_TargetLanguage">目标语言</sys:String>
    <sys:String x:Key="SettingPage_ApiSetting">API 设置</sys:String>
    <sys:String x:Key="SettingPage_ShowLatency">显示延迟</sys:String>
    <sys:String x:Key="SettingPage_Contexts">上下文句数</sys:String>
    <sys:String x:Key="SettingPage_DisplaySentences">显示句数</sys:String>
