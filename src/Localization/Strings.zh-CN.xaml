    <sys:String x:Key="SettingPage_LangEnglish">English</sys:String>
    <sys:String x:Key="SettingPage_LangChinese">简体中文</sys:String>

    <!-- 悬浮提示：实时字幕 -->
    <sys:String x:Key="SettingPage_FlyoutLiveCaptions_1">在 Windows 11 24H2 及之后的版本中，你只能在实时字幕里修改</sys:String>
    <sys:String x:Key="SettingPage_FlyoutLiveCaptions_2">源语言</sys:String>
    <sys:String x:Key="SettingPage_FlyoutLiveCaptions_3">。&#x0A;&#x0A;注意：请点击「隐藏」来隐藏实时字幕，不要直接关闭它。</sys:String>

    <!-- 悬浮提示：API 间隔 -->
    <sys:String x:Key="SettingPage_FlyoutInterval_1">决定翻译 API 的调用频率。该值越小，调用越频繁。&#x0A;原文每变化「API 调用间隔」次，才会调用一次翻译 API。</sys:String>

    <!-- 悬浮提示：翻译 API -->
    <sys:String x:Key="SettingPage_FlyoutTranslateApi_1">除 Google 与 Google2 外，其他 API 都需要先配置才能使用。</sys:String>

    <!-- 悬浮提示：目标语言 -->
    <sys:String x:Key="SettingPage_FlyoutTargetLang_1">「下拉列表里没有我想要的目标语言！」&#x0A;你可以直接编辑这个下拉框的内容来自定义语言，建议遵循 BCP 47 语言标签规范。&#x0A;&#x0A;注意：部分 API（例如 DeepL）需要用另一种方式指定目标语言，详见其官方文档。内置的语言已经做好了标签映射，无需额外处理；但如果你期望的语言不在列表中，请留意这一点。</sys:String>

    <!-- 悬浮提示：上下文句数 / 显示句数 -->
    <sys:String x:Key="SettingPage_FlyoutContexts_1">上下文句数：开启「上下文感知」后，作为上下文送入模型的句子数量。&#x0A;显示句数：开启「日志卡片」时显示的卡片数量，同时也是悬浮窗中显示的最大句子数。&#x0A;&#x0A;注意：上下文句数必须大于或等于显示句数。若不满足，程序会自动调整。</sys:String>

    <!-- 悬浮提示：上下文感知 -->
    <sys:String x:Key="SettingPage_FlyoutContextAware_1">结合上下文进行翻译。&#x0A;可以提升翻译准确度，但会消耗更多 token。</sys:String>

    <!--============================================================
        API 设置窗口
    ============================================================-->
    <sys:String x:Key="ApiSetting_Title">API 设置</sys:String>
    <sys:String x:Key="ApiSetting_Prompt">提示词</sys:String>
    <sys:String x:Key="ApiSetting_Ollama">Ollama</sys:String>
    <sys:String x:Key="ApiSetting_LMStudio">LMStudio</sys:String>
    <sys:String x:Key="ApiSetting_OpenAI">OpenAI</sys:String>
    <sys:String x:Key="ApiSetting_OpenRouter">OpenRouter</sys:String>
    <sys:String x:Key="ApiSetting_DeepL">DeepL</sys:String>
    <sys:String x:Key="ApiSetting_Youdao">有道翻译</sys:String>
    <sys:String x:Key="ApiSetting_MTranServer">MTranServer</sys:String>
    <sys:String x:Key="ApiSetting_Baidu">百度翻译</sys:String>
    <sys:String x:Key="ApiSetting_LibreTranslate">LibreTranslate</sys:String>

    <!-- 悬浮提示：提示词说明 -->
    <sys:String x:Key="ApiSetting_PromptNote1">说明 1：提示词中的 {0} 表示目标语言，请确保你的提示词里包含 {0}。&#x0A;</sys:String>
    <sys:String x:Key="ApiSetting_PromptNote2">说明 2：待翻译的原文会被 🔤 包裹。</sys:String>

    <!-- 悬浮提示：Ollama 地址 -->
    <sys:String x:Key="ApiSetting_FlyoutOllamaUrl">无需手动添加 `api/chat` 后缀。</sys:String>
    <!-- 悬浮提示：LMStudio 地址 -->
    <sys:String x:Key="ApiSetting_FlyoutLMStudioUrl">以 `api/v1` 结尾的基地址。聊天接口与模型列表会自动拼接。</sys:String>
    <!-- 悬浮提示：OpenAI 地址 -->
    <sys:String x:Key="ApiSetting_FlyoutOpenAIUrl">请填写完整地址（通常以 `v1/chat/completions` 结尾），而不是基地址（通常只以 `v1` 结尾）。</sys:String>

    <!--============================================================
        关于页
    ============================================================-->
    <sys:String x:Key="Info_Intro1">我们欢迎任何形式的贡献！你可以通过 GitHub Issues 提出建议或报告问题，也可以直接提交 Pull Request 贡献代码。&#x0A;如果这个程序对你有帮助，欢迎给我们点个 star ✨！</sys:String>
    <sys:String x:Key="Info_Repository">代码仓库：</sys:String>
    <sys:String x:Key="Info_Wiki">Wiki：</sys:String>
    <sys:String x:Key="Info_Maintainer">维护者：</sys:String>
    <sys:String x:Key="Info_AuthorAnd">（作者）与 </sys:String>
    <sys:String x:Key="Info_Version">版本：</sys:String>

    <!--============================================================
        欢迎窗口
    ============================================================-->
    <sys:String x:Key="Welcome_Title">开始使用</sys:String>
    <sys:String x:Key="Welcome_Head">欢迎使用 LiveCaptions Translator！</sys:String>
    <sys:String x:Key="Welcome_Body_1">LiveCaptions Translator 基于 Windows 实时字幕运行。首次使用前，你需要按以下步骤完成配置：&#x0A;</sys:String>
    <sys:String x:Key="Welcome_Body_2">&#x0A;1. 打开 Windows 实时字幕，按其引导下载设备端语音识别所需的文件和语言包。</sys:String>
    <sys:String x:Key="Welcome_Body_3">&#x0A;2. 点击实时字幕里的 </sys:String>
    <sys:String x:Key="Welcome_Body_4">⚙️ 齿轮</sys:String>
    <sys:String x:Key="Welcome_Body_5"> 图标打开设置菜单，选择 </sys:String>
    <sys:String x:Key="Welcome_Body_6">「位置 &gt; 覆盖在屏幕上」</sys:String>
    <sys:String x:Key="Welcome_Body_7">。&#x0A;3. 点击 LiveCaptions Translator 设置页中的 </sys:String>
    <sys:String x:Key="Welcome_Body_8">「隐藏」</sys:String>
    <sys:String x:Key="Welcome_Body_9"> 按钮来隐藏 Windows 实时字幕。&#x0A;&#x0A;程序已自动跳转到设置页并打开了 Windows 实时字幕。完成配置后，你可以切回主页面，开始享受实时语音翻译。&#x0A;&#x0A;更多细节请访问我们的 Wiki：</sys:String>
    <sys:String x:Key="Welcome_Body_10">&#x0A;&#x0A;提示：如需修改</sys:String>
    <sys:String x:Key="Welcome_Body_11">源语言</sys:String>
    <sys:String x:Key="Welcome_Body_12">，请在设置页点击「显示」打开实时字幕，然后在实时字幕里修改。</sys:String>
    <sys:String x:Key="Welcome_ConfirmButton">我已充分理解并完成配置</sys:String>

